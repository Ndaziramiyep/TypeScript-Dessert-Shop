{
  "name": "typescript-dessert-shop",
  "version": "1.0.0",
  "description": "TypeScript Dessert Shop with Shopping Cart",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc && tailwindcss -i ./styles/main.css -o ./dist/styles.css --minify",
    "dev": "concurrently \"tsc --watch\" \"tailwindcss -i ./styles/main.css -o ./dist/styles.css --watch --minify\"",
    "start": "live-server --port=3000",
    "dev:all": "concurrently \"npm run dev\" \"npm start\""
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "concurrently": "^8.2.0",
    "live-server": "^1.2.2"
  },
  "type": "module"
}